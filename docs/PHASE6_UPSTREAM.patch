diff --git a/cron/execution_policy.py b/cron/execution_policy.py
new file mode 100755
index 0000000..43c06b2
--- /dev/null
+++ b/cron/execution_policy.py
@@ -0,0 +1,274 @@
+"""Opt-in embedded cron authorization. Scheduling and claims remain Hermes-owned.
+
+The trusted host registers one policy per profile before starting the ticker.
+Required profiles support only local, in-process, audited no-agent scripts.
+This is an application boundary, not a sandbox for hostile same-user code.
+"""
+from __future__ import annotations
+
+import contextvars
+import functools
+import hashlib
+import json
+import math
+import os
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import ContextManager, Protocol
+
+import yaml
+
+
+class AuthorizationDenied(RuntimeError):
+    """A required execution did not acquire exact authority."""
+
+
+@dataclass(frozen=True)
+class ExecutionRequest:
+    profile_home: Path
+    job_json: str
+    execution_id: str
+    fingerprint: str
+
+
+@dataclass(frozen=True)
+class ExecutionLease:
+    fingerprint: str
+    script: bytes
+    expires_at: float  # monotonic deadline, checked before script admission
+
+
+class ExecutionPolicy(Protocol):
+    def acquire(self, request: ExecutionRequest) -> ContextManager[ExecutionLease]: ...
+
+
+@dataclass
+class _Active:
+    request: ExecutionRequest
+    lease: ExecutionLease
+    job_started: bool = False
+    script_started: bool = False
+
+
+_lock = threading.RLock()
+_policies: dict[Path, tuple[str, bytes, ExecutionPolicy]] = {}
+_faulted: set[Path] = set()
+_active: contextvars.ContextVar[_Active | None] = contextvars.ContextVar(
+    "cron_execution_lease", default=None)
+
+
+def _home() -> Path:
+    from hermes_constants import get_hermes_home
+    return get_hermes_home().resolve()
+
+
+class _ConfigLoader(yaml.SafeLoader):
+    def construct_mapping(self, node, deep=False):
+        keys = [self.construct_object(key, deep=deep) for key, _ in node.value]
+        if len(keys) != len(set(keys)):
+            raise ValueError("duplicate config key")
+        return super().construct_mapping(node, deep=deep)
+
+
+def _config(home: Path) -> tuple[str | None, bytes]:
+    try:
+        path = home / "config.yaml"
+        raw = path.read_bytes() if path.exists() else b""
+        config = yaml.load(raw, Loader=_ConfigLoader) or {}
+        if not isinstance(config, dict):
+            raise ValueError
+        cron = config.get("cron", {})
+        if not isinstance(cron, dict):
+            raise ValueError
+        name = cron.get("execution_policy")
+        if name is not None and (not isinstance(name, str) or not name.strip()):
+            raise ValueError
+        return name, raw
+    except Exception as exc:
+        raise AuthorizationDenied("authorization_config_invalid") from exc
+
+
+def register_execution_policy(home: Path, policy_id: str, policy: ExecutionPolicy) -> None:
+    home = Path(home).resolve()
+    name, raw = _config(home)
+    if (not isinstance(policy_id, str) or not policy_id or name != policy_id
+            or not callable(getattr(policy, "acquire", None))):
+        raise AuthorizationDenied("authorization_registration_invalid")
+    with _lock:
+        if home in _policies:
+            raise AuthorizationDenied("authorization_already_registered")
+        _policies[home] = (policy_id, raw, policy)
+
+
+def resolve_policy() -> ExecutionPolicy | None:
+    home = _home()
+    name, raw = _config(home)
+    with _lock:
+        installed = _policies.get(home)
+        if home in _faulted:
+            raise AuthorizationDenied("authorization_runtime_faulted")
+    if installed is not None:
+        if (name, raw) != installed[:2]:
+            raise AuthorizationDenied("authorization_config_changed")
+        return installed[2]
+    if name is not None:
+        raise AuthorizationDenied("authorization_policy_unavailable")
+    return None
+
+
+def _json(job: dict) -> str:
+    return json.dumps(job, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _validate(job: dict, extra_prompt) -> None:
+    allowed = set("""id name prompt skills skill model provider base_url provider_snapshot
+        model_snapshot script no_agent monitor_script monitor_url monitor_state context_from
+        schedule schedule_display repeat enabled state paused_at paused_reason created_at
+        next_run_at last_run_at last_status last_error last_delivery_error
+        last_delivery_unverified failure_streak deliver origin enabled_toolsets workdir
+        attach_to_session reasoning_effort failure_deliver fire_claim run_claim
+        execution_id _scheduled_instant manual_run_prompt manual_run_at
+        preflight_alerted last_fire_error last_delivery_queued""".split())
+    if set(job) - allowed:
+        raise AuthorizationDenied("authorization_unknown_field")
+    if (job.get("no_agent") is not True or job.get("deliver") != "local"
+            or job.get("failure_deliver") != "local" or extra_prompt is not None
+            or not isinstance(job.get("script"), str) or not job["script"]):
+        raise AuthorizationDenied("authorization_job_shape")
+    forbidden = (
+        "origin", "skills", "skill", "model", "provider", "base_url",
+        "provider_snapshot", "model_snapshot", "monitor_script", "monitor_url",
+        "monitor_state", "context_from", "workdir", "enabled_toolsets",
+        "attach_to_session", "reasoning_effort", "manual_run_prompt",
+    )
+    if any(job.get(key) not in (None, [], False, "") for key in forbidden):
+        raise AuthorizationDenied("authorization_forbidden_field")
+
+
+def active_lease(job: dict | None = None, *, start_job: bool = False) -> _Active | None:
+    policy = resolve_policy()
+    active = _active.get()
+    if policy is None:
+        if active is not None:
+            raise AuthorizationDenied("authorization_profile_changed")
+        return None
+    if (active is None or active.request.profile_home != _home()
+            or (job is not None and _json(job) != active.request.job_json)):
+        raise AuthorizationDenied("authorization_lease_missing")
+    if start_job:
+        if active.job_started:
+            raise AuthorizationDenied("authorization_replay")
+        active.job_started = True
+    return active
+
+
+def script_input(script_path: str, workdir, cancel_event) -> str | None:
+    active = active_lease()
+    if active is None:
+        return None
+    job = json.loads(active.request.job_json)
+    if (not active.job_started or active.script_started or workdir is not None
+            or script_path != job["script"]
+            or time.monotonic() >= active.lease.expires_at
+            or (cancel_event is not None and cancel_event.is_set())):
+        raise AuthorizationDenied("authorization_script_denied")
+    active.script_started = True
+    return active.lease.script.decode("utf-8")
+
+
+def _deny(job: dict) -> None:
+    from cron.executions import finish_execution
+    from cron.jobs import fire_claim_fence, pause_job, update_job
+    owner = (job.get("fire_claim") or {}).get("by")
+    if owner:
+        with fire_claim_fence(job["id"], expected_owner=owner) as owns:
+            if owns:
+                pause_job(job["id"], reason="authorization_denied")
+                update_job(job["id"], {"fire_claim": None, "run_claim": None})
+    if not finish_execution(job["execution_id"], success=False,
+                            error="authorization_denied", delivery_outcome="suppressed"):
+        raise AuthorizationDenied("authorization_attempt_not_owned")
+
+
+def authorize_execution(function):
+    """Gate the shared entry, never serialize leases into detached payloads."""
+    def execute(job, *args, **kwargs):
+        # Resolution errors propagate before any external launch or execution.
+        policy = resolve_policy()
+        if policy is None:
+            return function(job, *args, **kwargs)
+        if _active.get() is not None:
+            raise AuthorizationDenied("authorization_nested_execution")
+        from cron.executions import create_execution, get_execution
+        from cron.jobs import get_job, is_job_runnable
+        snapshot = json.loads(_json(job))
+        if not snapshot.get("execution_id"):
+            snapshot["execution_id"] = create_execution(
+                snapshot["id"], source="authorized",
+                scheduled_instant=snapshot.get("_scheduled_instant"))["id"]
+        attempt = get_execution(snapshot["execution_id"])
+        if (not attempt or attempt["job_id"] != snapshot["id"]
+                or attempt["status"] != "claimed" or attempt["pid"] != os.getpid()):
+            raise AuthorizationDenied("authorization_attempt_invalid")
+        entered = False
+        try:
+            _validate(snapshot, kwargs.get("extra_prompt"))
+            current = get_job(snapshot["id"])
+            if current is None or not is_job_runnable(current):
+                raise AuthorizationDenied("authorization_job_inactive")
+            # Claims/occurrence metadata are attached by Hermes; all persisted
+            # fields must still match the claimed snapshot before host approval.
+            if any(snapshot.get(k) != v for k, v in current.items()):
+                raise AuthorizationDenied("authorization_job_changed")
+            raw = _json(snapshot)
+            fingerprint = hashlib.sha256((_home().as_posix() + raw).encode()).hexdigest()
+            request = ExecutionRequest(_home(), raw, snapshot["execution_id"], fingerprint)
+            with policy.acquire(request) as lease:
+                if (type(lease) is not ExecutionLease or lease.fingerprint != fingerprint
+                        or type(lease.script) is not bytes or not 0 < len(lease.script) <= 65536
+                        or not isinstance(lease.expires_at, (int, float))
+                        or not math.isfinite(lease.expires_at)
+                        or not time.monotonic() < lease.expires_at):
+                    raise AuthorizationDenied("authorization_lease_invalid")
+                lease.script.decode("utf-8")
+                resolve_policy()
+                current = get_job(snapshot["id"])
+                if (current is None or not is_job_runnable(current)
+                        or any(snapshot.get(k) != v for k, v in current.items())):
+                    raise AuthorizationDenied("authorization_job_changed")
+                if kwargs.get("cancel_event") is not None and kwargs["cancel_event"].is_set():
+                    raise AuthorizationDenied("authorization_cancelled")
+                token = _active.set(_Active(request, lease))
+                try:
+                    entered = True
+                    result = function(snapshot, *args, **kwargs)
+                    if result is False:
+                        with _lock:
+                            _faulted.add(request.profile_home)
+                    return result
+                finally:
+                    _active.reset(token)
+        except Exception as exc:
+            if not entered:
+                try:
+                    _deny(snapshot)
+                except BaseException:
+                    with _lock:
+                        _faulted.add(_home())
+                    raise
+                raise AuthorizationDenied("authorization_denied") from exc
+            raise
+    @functools.wraps(function)
+    def wrapped(job, *args, **kwargs):
+        try:
+            return execute(job, *args, **kwargs)
+        except AuthorizationDenied:
+            raise
+        except BaseException:
+            with _lock:
+                if _home() in _policies:
+                    _faulted.add(_home())
+            raise
+    return wrapped
